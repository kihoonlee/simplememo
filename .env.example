# ── SimpleMemo environment ── copy to .env.local and fill in (see SETUP.md) ──

# Auth.js session secret. Generate with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Web application) — Google Cloud Console > Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Browser-side values for the Google Picker (folder selection)
# API key (Google Cloud Console > Credentials > API key, restricted to Picker API)
NEXT_PUBLIC_GOOGLE_API_KEY=
# Same OAuth client id as AUTH_GOOGLE_ID (used by the browser token client for Picker)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Google Cloud project NUMBER (Picker requires the app id / project number)
NEXT_PUBLIC_GOOGLE_APP_ID=

# Convenience: the Drive folder you provided. Used only as a Picker default hint.
NEXT_PUBLIC_DEFAULT_FOLDER_ID=1draGG7AxTJ4_pSSkKbrt1fvEWxbuWHTs
